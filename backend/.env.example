# ==============================================================================
# Cloud Virtual Lab and Secure Storage Management System - Backend Environment
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Syntax: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloud_virtual_lab?schema=public"

# Authentication & Session Security
# Generate secure 64-character secret in production using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min32chars
JWT_EXPIRES_IN=1d
# Cookie Security (lax for same-origin/reverse-proxy; none for cross-site HTTPS deployment e.g. Vercel+Render)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# AES-256-GCM Encrypted Storage Subsystem
# Master key must be a 256-bit (32-byte) key represented as 64 hex characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
STORAGE_UPLOAD_PATH=../storage/uploads
MAX_FILE_SIZE_MB=25
DEFAULT_USER_QUOTA_MB=100

# Initial Root Administrator Account (Populated via: npm run prisma:seed)
ADMIN_EMAIL=admin@virtuallab.edu
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
