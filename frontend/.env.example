# API Base URL
# Option A (Local development with Vite proxy or production with Nginx reverse proxy):
VITE_API_URL=/api

# Option B (Separate frontend CDN hosting, e.g. Vercel, Netlify, Cloudflare Pages):
# VITE_API_URL=https://api.yourdomain.com
